	partition '- How Healthy Is Our Customer Base?' = calculated
		mode: import
		source =
				{
				    ("Activity Churn Status", NAMEOF('Dim_Customers'[Activity Churn Status]), 0),
				    ("Purchase Churn Status", NAMEOF('Dim_Customers'[dynamic_churn_status]), 1)
				}

	annotation PBI_Id = e193788a3d0d43f09127fc91f586884b

