	column 'Customer Spending Tier' = ```
			
			-- Calculate Average Order Value (AOV) per customer for completed orders
			VAR UserAOV = 
			    DIVIDE(
			        'Dim_Customers'[total_lifetime_value], 
			        'Dim_Customers'[total_completed_orders], 
			        0
			    )
			
			-- Calculate Q1 (25th Percentile) across active buyers only
			VAR Q1_Threshold = 
			    CALCULATE(
			        PERCENTILEX.INC(
			            FILTER('Dim_Customers', 'Dim_Customers'[total_completed_orders] > 0),
			            DIVIDE('Dim_Customers'[total_lifetime_value], 'Dim_Customers'[total_completed_orders], 0),
			            0.25
			        ),
			        ALL('Dim_Customers')
			    )
			
			-- Calculate Q3 (75th Percentile) across active buyers only
			VAR Q3_Threshold = 
			    CALCULATE(
			        PERCENTILEX.INC(
			            FILTER('Dim_Customers', 'Dim_Customers'[total_completed_orders] > 0),
			            DIVIDE('Dim_Customers'[total_lifetime_value], 'Dim_Customers'[total_completed_orders], 0),
			            0.75
			        ),
			        ALL('Dim_Customers')
			    )
			
			RETURN
			    -- Classify customers into statistical Quartile tiers based on purchasing power
			    SWITCH(
			        TRUE(),
			        'Dim_Customers'[total_completed_orders] = 0, "Non-Buyer",
			        UserAOV >= Q3_Threshold, "VIP",
			        UserAOV >= Q1_Threshold, "Standard",
			        "Budget"
			    )
			```
		lineageTag: e1f023ce-9784-415a-bc07-332d59d18a9c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Activity Churn Status' = ```
			
			VAR CurrentUserID = 'Dim_Customers'[user_id]
			-- Force filtering dim_sessions by the current row's user_id even if relationship is inactive
			VAR LastSessionDate = 
			    CALCULATE(
			        MAX('dim_sessions'[session_start]),
			        FILTER(
			            ALL('dim_sessions'),
			            'dim_sessions'[user_id] = CurrentUserID
			        )
			    )
			VAR SnapshotDate = DATE(2026, 6, 30)
			VAR DaysSinceLastSession = DATEDIFF(DATEVALUE(LastSessionDate), SnapshotDate, DAY)
			VAR MedianBenchmark = 'Dim_Customers'[benchmark_median]
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(LastSessionDate), "No Activity",
			        DaysSinceLastSession < MedianBenchmark, "Active Browser",
			        DaysSinceLastSession <= (MedianBenchmark * 2), "At-Risk Browser",
			        "Activity Churned"
			    )
			```
		lineageTag: 2f944357-0d17-41d0-a8c1-3a062b2da06c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Lost_NonBuyers_Paid_Last_Assortment = ```
			
			VAR CurrentUser = Dim_Customers[user_id]
			
			-- 1. التأكد إن العميل حساب ميت (Never Bought + Activity Churned) وكمان جاي من Paid
			VAR IsDeadAndPaid = 
			    Dim_Customers[dynamic_churn_status] = "Never Bought" && 
			    Dim_Customers[Activity Churn Status] = "Activity Churned" &&
			    (Dim_Customers[acquisition_source] = "Paid Search" || Dim_Customers[acquisition_source] = "Paid Social")
			
			-- 2. جلب آخر شريحة تسعيرية (Assortment) شافها العميل قبل ما يمشي
			VAR LastAssortment = 
			    MAXX(
			        TOPN(
			            1,
			            FILTER(
			                Fact_Events,
			                RELATED(Dim_Sessions[user_id]) = CurrentUser && 
			                (Fact_Events[event_name] = "view_item" || Fact_Events[event_name] = "View Item")
			            ),
			            Fact_Events[Event Date time], 
			            DESC
			        ),
			        -- استدعاء عمود التسعير (Premium, Core, Entry-Level)
			        RELATED(Dim_products[Product Price Tier]) 
			    )
			
			-- 3. إرجاع النتيجة للعملاء المستهدفين فقط
			RETURN 
			    IF(IsDeadAndPaid, LastAssortment, BLANK())
			```
		lineageTag: 98c148f7-ad40-4a78-9335-8c33b7eee617
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

