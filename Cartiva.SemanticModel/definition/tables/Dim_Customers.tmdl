table Dim_Customers
	lineageTag: d85c803a-ac4c-40a4-8b43-594c4d1d603c

	measure 'Total users' =
			
			DISTINCTCOUNT(Dim_Customers[user_id])
		formatString: 0
		lineageTag: 1c5cc095-a063-4522-a381-d30c37a0dfc2

	measure 'Purchasing Users' =
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_Sales[user_id]),
			    Fact_Sales[order_status] = "Completed"
			)
		formatString: 0
		lineageTag: e8839ba0-bd43-4cc3-af59-f38afb7c69c9

	measure 'User Purchase Rate %' =
			
			DIVIDE(
			    [Purchasing Users],
			    [Total Users]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a5c95d6b-3039-40e0-bf2f-b9f5da04deef

	measure 'Total Customer Leakage %' = ```
			
			VAR _LeakedCustomers = 
			    CALCULATE(
			        DISTINCTCOUNT(Dim_Customers[user_id]),
			        Dim_Customers[dynamic_churn_status] IN {"Never Bought", "At-Risk", "Churned"}
			    )
			VAR _TotalCustomers = 
			    COUNTROWS(Dim_Customers)
			RETURN 
			    DIVIDE(_LeakedCustomers, _TotalCustomers, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c2716266-8777-47a0-9357-6a625ac3a362

	measure 'Total Leakage Subtitle' =
			
			"Including Never Bought, At-Risk & Churned"
		lineageTag: b85efe62-33b9-4d3e-bd08-215ff1e50e73

	measure 'Active Non-Buyers' =
			
			CALCULATE(
			    DISTINCTCOUNT(Dim_Customers[user_id]),
			    Dim_Customers[dynamic_churn_status] = "Never Bought",
			    Dim_Customers[Activity Churn Status]= "Active Browser"
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: bade8a74-b625-4c75-b400-c664f38f2a4e

	measure 'Active Non-Buyers Subtitle' =
			
			"$5.52M Untapped Revenue" & UNICHAR(10) & "(at 30% Target Conv.)"
		lineageTag: a46e8be9-6ccb-496f-8e7e-030a31ded8d8

	measure 'Structural VIP Churn %' = ```
			
			VAR _RiskChurnVIP = 
			    CALCULATE(
			        DISTINCTCOUNT(Dim_Customers[user_id]),
			        Dim_Customers[Customer Spending Tier] = "VIP",
			        Dim_Customers[dynamic_churn_status] IN {"At-Risk", "Churned"}
			    )
			VAR _TotalVIP = 
			    CALCULATE(
			        DISTINCTCOUNT(Dim_Customers[user_id]),
			        Dim_Customers[Customer Spending Tier] = "VIP"
			    )
			RETURN 
			    DIVIDE(_RiskChurnVIP, _TotalVIP, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d80112b4-43f1-4428-9a02-f75ea1c12e67

	measure 'Wasted Paid CAC' = ```
			
			VAR _WastedAccounts = 
			    CALCULATE(
			        DISTINCTCOUNT(Dim_Customers[user_id]),
			        Dim_Customers[dynamic_churn_status] IN {"Never Bought", "Churned"},
			        Dim_Customers[acquisition_source] IN {"Paid Search", "Paid Social"} 
			        -- تأكد من اسم عمود مصدر الزيارات في جدولك (قد يكون traffic_source)
			    )
			VAR _EstimatedCAC = 15 -- متوسط تكلفة الاستحواذ بالدولار
			RETURN 
			    _WastedAccounts * _EstimatedCAC
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: cf455032-118e-4cd4-9ea7-eabb36cb14c5

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% of Total Customers' =
			
			DIVIDE(
			    [Total users],
			    CALCULATE([Total users], ALL(Dim_Customers)),
			    0
			)
		formatString: 0.00%;-0.00%;"-"
		lineageTag: 8f9b08d2-1001-46e8-9d5d-e78af19984a7

		annotation PBI_FormatHint = {"isCustom":true}

