	column order_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: daa61812-dd4b-4b4e-80af-2dc0bff42641
		summarizeBy: none
		sourceColumn: order_date

		variation Variation
			isDefault
			relationship: 9d7342a6-ccf8-4bb4-b204-9b7641b6d124
			defaultHierarchy: LocalDateTable_98a7525d-29a7-4b8a-9782-c042cbbaedb9.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column order_status
		dataType: string
		lineageTag: e25a04da-c848-4224-a775-4f8a6274e724
