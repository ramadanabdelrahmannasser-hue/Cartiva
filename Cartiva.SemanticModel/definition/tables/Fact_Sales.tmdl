		summarizeBy: sum
		sourceColumn: quantity

		annotation SummarizationSetBy = Automatic

	column unit_price
		dataType: double
		lineageTag: eef211f6-ca12-4367-9ff7-d74e6219e6e0
		summarizeBy: sum
		sourceColumn: unit_price

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column line_amount
		dataType: double
		lineageTag: cd6323bc-81de-4ed0-ab46-b40a63222471
		summarizeBy: sum
		sourceColumn: line_amount

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column order_time
		dataType: dateTime
		formatString: Long Time
		lineageTag: b162cdd1-0047-4259-8a6d-5abdff8380a0
		summarizeBy: none
		sourceColumn: order_time

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Time

	column order_lifecycle_tag
		dataType: string
		lineageTag: 0d27707e-c816-4d15-9dbc-12c8b07a629b
		summarizeBy: none
		sourceColumn: order_lifecycle_tag

		annotation SummarizationSetBy = Automatic

	column 'Order Type' =
			
			IF(
			  Fact_Sales[order_lifecycle_tag] = "Repeat Purchase",
			    "Repeat Purchase",
			    "First Purchase"
			)
		lineageTag: 37f237ac-32c2-499d-937b-a0f240b7dacb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition Fact_Sales = m
		mode: import
		source =
				let
				    Source = Odbc.DataSource("dsn=Cartiva_DW", [HierarchicalNavigation=true]),
				    ecommerce_product_analytics_dw_Database = Source{[Name="ecommerce_product_analytics_dw",Kind="Database"]}[Data],
				    vw_fact_sales_enriched_View = ecommerce_product_analytics_dw_Database{[Name="vw_fact_sales_enriched",Kind="View"]}[Data],
				  #"Marked key columns" = Table.AddKey(vw_fact_sales_enriched_View, {"order_item_id", "order_id"}, false),
				  #"Reordered columns" = Table.ReorderColumns(#"Marked key columns", {"order_item_id", "order_id", "user_id", "session_id", "product_id", "order_date", "order_time", "order_status", "quantity", "unit_price", "line_amount", "order_lifecycle_tag"})
				in
				    #"Reordered columns"

	annotation PBI_ResultType = Table

