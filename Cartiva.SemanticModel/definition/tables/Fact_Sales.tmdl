table Fact_Sales
	lineageTag: 9d9c0cba-b182-4f4c-988b-39e740f57563

	measure 'Total Revenue' =
			
			CALCULATE(
			    SUM(Fact_Sales[line_amount]),
			    Fact_Sales[order_status] = "Completed"
			)
		formatString: 0
		lineageTag: ba3a9c86-3db7-4a0b-b227-a0b68bbb10f9

	measure 'Completed Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_Sales[order_id]),
			    Fact_Sales[order_status] = "Completed"
			)
		formatString: 0
		lineageTag: 32524487-1b74-44c2-95ce-b16f5848717e

	measure 'Average Order Value' =
			
			DIVIDE(
			    [Total Revenue],
			    [Completed Orders]
			)
		lineageTag: ad28dfc6-5425-403c-aaf2-dabf78f1d89c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Measure
		lineageTag: cf37074d-c411-4549-b419-7b876d5b37ca

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Total __users' =
			
			DISTINCTCOUNT(Fact_Sales[user_id])
		formatString: 0
		lineageTag: 5bbf4daf-0d84-4e15-9e7a-71d2b76c9226

	measure 'First Purchase Orders' =
			
			CALCULATE(
			    [Completed Orders],
			    Fact_Sales[order_lifecycle_tag]
			        IN {
			            "Immediate First Purchase",
			            "Delayed First Purchase"
			        }
			)
		formatString: 0
		lineageTag: 0da79b5e-bc94-4887-8e70-d0f7206407c8

	measure 'Total Lifecycle Orders' =
			
			[First Purchase Orders] + [Repeat Purchase Orders]
		lineageTag: 8fc69563-cbad-4769-a668-9f73ad52f14c

	measure '% of Total Orders' =
			
			DIVIDE(
			    [Completed Orders],
			    [Total Lifecycle Orders],
			    0
			)
		lineageTag: ef8dffa0-84c2-45e8-8476-b95bc7687057

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Repeat Purchase Orders' =
			
			CALCULATE(
			    [Completed Orders],
			   Fact_Sales[order_lifecycle_tag] = "Repeat Purchase"
			)
		formatString: 0
		lineageTag: 5e074baf-7962-4b42-953a-d80bb11e424a

	measure 'Repeat Orders % Label' =
			
			FORMAT(
			    DIVIDE(
			        [Repeat Purchase Orders],
			        [Total Lifecycle Orders],
			        0
			    ),
			    "0.0%"
			)
			& " Repeat Orders"
		lineageTag: 3690dd57-f6af-4bf2-bfa6-d5a744d4c252

	column order_item_id
		dataType: int64
		formatString: 0
		lineageTag: 5cab7570-8c3a-4375-b789-ee67ff16feb0
		summarizeBy: sum
		sourceColumn: order_item_id

		annotation SummarizationSetBy = Automatic

	column order_id
		dataType: int64
		formatString: 0
		lineageTag: 57ed4959-0261-463a-8506-39eb18dfa7b5
		summarizeBy: sum
		sourceColumn: order_id

		annotation SummarizationSetBy = Automatic

	column user_id
		dataType: int64
		formatString: 0
		lineageTag: 9d10db01-2913-4bcc-944a-1ceb8f13ee53
		summarizeBy: none
		sourceColumn: user_id

		annotation SummarizationSetBy = Automatic

	column session_id
		dataType: int64
